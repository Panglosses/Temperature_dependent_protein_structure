title = Production MD
integrator = md
dt = 0.002
nsteps = 25000000
nstxout = 0
nstvout = 0
nstenergy = 5000
nstlog = 5000
nstxout-compressed = 5000
compressed-x-grps = System
cutoff-scheme = Verlet
rlist = 1.0
rcoulomb = 1.0
rvdw = 1.0
pbc = xyz
tcoupl = V-rescale
tc-grps = Protein Non-Protein
tau_t = 0.1 0.1
ref_t = __TEMP__ __TEMP__
pcoupl = Parrinello-Rahman
pcoupltype = isotropic
tau_p = 2.0
ref_p = 1.0
compressibility = 4.5e-5
continuation = yes
constraints = h-bonds
constraint_algorithm = lincs
lincs_order = 4
lincs_iter = 1
comm-mode = Linear
comm-grps = Protein
